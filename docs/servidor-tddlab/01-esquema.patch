+++ b/server/scripts/migrar-registro-ramas.ts
@@ -0,0 +1,21 @@
+import { readFileSync } from "fs";
+import { resolve } from "path";
+import { Client } from "pg";
+import config from "../src/config/db";
+
+async function migrate() {
+  const sql = readFileSync(resolve(__dirname, "../../ModeloDatos/database/registro-ramas.sql"), "utf8");
+  const client = new Client(config);
+  await client.connect();
+  try {
+    await client.query(sql);
+    console.log("Esquema de registro de ramas actualizado.");
+  } finally {
+    await client.end();
+  }
+}
+
+migrate().catch(error => {
+  console.error("No se pudo actualizar el esquema:", error.message);
+  process.exitCode = 1;
+});
