{
    "name":  "parcel-jest-base",
    "version":  "1.0.0",
    "description":  "",
    "default":  "index.html",
    "type":  "module",
    "scripts":  {
                    "start":  "parcel index.html",
                    "build":  "parcel build index.html",
                    "test":  "npm run test:unit",
                    "test:unit":  "node ./node_modules/jest/bin/jest.js --runInBand && npm run test:runner && npm run test:branches",
                    "test:runner":  "jest --runInBand --roots ./script --runTestsByPath ./script/__tests__/tddScript.test.js",
                    "test:branches":  "node --test script/__tests__/branch-push.test.mjs script/__tests__/pre-push-api.test.mjs script/__tests__/neon-activity-store.test.mjs",
                    "test:neon":  "node ./script/test-neon.js",
                    "test:neon:integration":  "node ./script/test-neon-integration.js",
                    "test:app":  "node ./script/tddScript.js",
                    "test:integration":  "npm run test:neon",
                    "test:e2e":  "npm run test:app",
                    "test:smoke":  "npm run test:unit",
                    "test:coverage":  "node ./node_modules/jest/bin/jest.js --coverage",
                    "db:init":  "node ./script/init-db.js",
                    "db:init:local":  "node ./script/init-db.js --local",
                    "db:init:remote":  "node ./script/init-db.js --remote",
                    "api:preparar":  "node ./script/preparar-api.js",
                    "db:sync":  "node ./script/pre-push-sync.js",
                    "db:pre-commit":  "node ./script/pre-commit-tracker.js",
                    "cypress":  "cypress open",
                    "cypress-run":  "cypress run",
                    "lint":  "eslint .",
                    "postinstall":  "git init \u0026\u0026 npx husky",
                    "semantic-commits-on":  "node semantic-commits.js enable",
                    "semantic-commits-off":  "node semantic-commits.js disabled"
                },
    "author":  "Israel Antezana R.",
    "license":  "ISC",
    "devDependencies":  {
                            "@babel/core":  "^7.25.2",
                            "@babel/preset-env":  "^7.25.4",
                            "babel-jest":  "^29.7.0",
                            "better-sqlite3":  "^11.0.0",
                            "cross-spawn":  "^7.0.3",
                            "cypress":  "^13.13.3",
                            "eslint":  "^9.10.0",
                            "globals":  "^17.14.0",
                            "husky":  "^9.1.6",
                            "jest":  "^29.7.0",
                            "parcel":  "^2.12.0"
                        },
    "dependencies":  {
                         "dotenv":  "^18.0.10",
                         "parcel-jest-base":  "file:",
                         "pg":  "^8.23.1"
                     },
    "allowScripts":  {
                         "@swc/core@1.7.18":  true,
                         "better-sqlite3@11.10.0":  true
                     }
}
