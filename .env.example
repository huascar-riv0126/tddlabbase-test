# Copia este archivo como .env para configurar el cliente de ramas.
# Nunca subas .env al repositorio.

# API que recibe el registro TDD al hacer push
TDD_BRANCHES_URL=http://localhost:3000/api/TDDCycles/branches/branches

# Base de datos local SQLite (opcional, por defecto: .tddlab/tddlab.db)
# SQLITE_DB_PATH=.tddlab/tddlab.db

# Control de hooks
# HUSKY_SKIP_TRACK=1 omite el tracking de BD en hooks (no recomendado)
