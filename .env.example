# Copy this file to .env and replace the placeholders.

# Neon PostgreSQL connection (required for direct database persistence).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional local SQLite database path (default: .tddlab/tddlab.db).
# SQLITE_DB_PATH=.tddlab/tddlab.db

# Legacy HTTP endpoint; used only when DATABASE_URL is not configured.
# TDD_BRANCHES_URL=http://localhost:3000/api/TDDCycles/branches/branches