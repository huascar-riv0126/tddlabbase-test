# Copia este archivo como .env y configura tus credenciales.
# Nunca subas .env al repositorio.

# Base de datos remota (Neon/PostgreSQL) - usada para sincronizar en pre-push
DATABASE_URL=postgresql://usuario:contraseña@host/base_de_datos?sslmode=require

# Base de datos local SQLite (opcional, por defecto: .tddlab/tddlab.db)
# SQLITE_DB_PATH=.tddlab/tddlab.db

# Opciones de seguridad
# Rechaza DATABASE_URL sin SSL cuando es 1 (recomendado en CI/producción)
REQUIRE_DB_SSL=0
# Permite hosts locales sin SSL (localhost/127.0.0.1)
ALLOW_LOCAL_DB_NO_SSL=1

# Control de hooks
# HUSKY_SKIP_TRACK=1 omite el tracking de BD en hooks (no recomendado)
